# Optional. If set, the contact form POSTs leads here (Formspree, Web3Forms,
# a Google Apps Script, or your own API endpoint — anything accepting JSON).
# If left empty the form falls back to opening WhatsApp with the message
# pre-filled, so an enquiry is never silently lost.
VITE_CONTACT_ENDPOINT=

# Passphrase for /admin. Change this before you deploy.
#
# NOTE: this site is static, so the check runs in the visitor's browser and the
# value ends up in the JavaScript bundle. It keeps casual visitors out of the
# editor; it is not a security boundary, and it does not need to be — nothing
# edited in the panel reaches the public until you commit a file. Do not reuse
# a password you use anywhere else.
VITE_ADMIN_PASSPHRASE=change-me-before-deploying
